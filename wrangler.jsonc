{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evan-karwowski-real-estate",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/", "/api/leads",
      "/compare", "/compare/*",
      "/buyer-plan", "/buyer-plan/*",
      "/seller-plan", "/seller-plan/*",
      "/open-house", "/open-house/*",
      "/thanks/*", "/book/*",
      "/preferences", "/preferences/*",
      "/resources/*"
    ]
  },
  "vars": {
    "FUB_SYSTEM": "EvanKarwowskiWebsite"
  }
}
