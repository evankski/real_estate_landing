{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evan-karwowski-real-estate",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/leads"]
  },
  "vars": {
    "FUB_SYSTEM": "EvanKarwowskiWebsite"
  }
}
